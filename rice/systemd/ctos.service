[Unit]
Description=ctOS personal dashboard server
Documentation=https://github.com/timurmomani0-glitch/Watchdogs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __REPO__ and __NPM__ are substituted by rice/install.sh at install time.
WorkingDirectory=__REPO__
ExecStart=__NPM__ start
Environment=PORT=7050
Environment=INTEGRATION_MODE=mock
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
