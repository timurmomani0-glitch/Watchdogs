// ctOS boot splash (Plymouth "script" module). No binary assets — the wordmark
// and progress bar are drawn from primitives, so this theme is self-contained.

Window.SetBackgroundTopColor(0.02, 0.03, 0.035);
Window.SetBackgroundBottomColor(0.01, 0.02, 0.025);

sw = Window.GetWidth();
sh = Window.GetHeight();

// ── Wordmark ─────────────────────────────────────────────────────────────────
logo.image  = Image.Text("DEDSEC", 0.122, 0.839, 0.812);
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(sw / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(sh / 2 - logo.image.GetHeight() / 2 - 46);

sub.image  = Image.Text("ctOS // commanding your own domain", 1.0, 0.478, 0.102);
sub.sprite = Sprite(sub.image);
sub.sprite.SetX(sw / 2 - sub.image.GetWidth() / 2);
sub.sprite.SetY(sh / 2 + 16);

// ── Progress bar (24 cells) ──────────────────────────────────────────────────
bar.sprite = Sprite();
bar.sprite.SetY(sh / 2 + 60);

fun draw_bar(fraction) {
    n = Math.Int(fraction * 24);
    s = "";
    i = 0;
    while (i < 24) {
        if (i < n) s = s + "#"; else s = s + ".";
        i++;
    }
    img = Image.Text(s, 0.122, 0.839, 0.812);
    bar.sprite.SetImage(img);
    bar.sprite.SetX(sw / 2 - img.GetWidth() / 2);
}
draw_bar(0);

fun progress_callback(duration, progress) {
    draw_bar(progress);
}
Plymouth.SetBootProgressFunction(progress_callback);

// ── Boot / status messages ───────────────────────────────────────────────────
msg.sprite = Sprite();
msg.sprite.SetY(sh / 2 + 100);
fun message_callback(text) {
    img = Image.Text(text, 0.337, 0.431, 0.455);
    msg.sprite.SetImage(img);
    msg.sprite.SetX(sw / 2 - img.GetWidth() / 2);
}
Plymouth.SetMessageFunction(message_callback);
